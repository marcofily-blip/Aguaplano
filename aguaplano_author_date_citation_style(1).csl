<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="it-IT">
  <info>
    <title>Aguaplano (Author-Date, Italian)</title>
    <title-short>Aguaplano</title-short>
    <id>http://www.zotero.org/styles/aguaplano-author-date</id>
    <link href="http://www.zotero.org/styles/aguaplano-author-date" rel="self"/>
    <link href="http://www.aguaplano.eu" rel="documentation"/>
    <author>
      <name>Gemini</name>
    </author>
    <category citation-format="author-date"/>
    <category field="humanities"/>
    <category field="social_science"/>
    <summary>Stile autore-data secondo il Normario redazionale Aguaplano (citazioni "scientifiche")</summary>
    <updated>2026-11-03T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale xml:lang="it">
    <terms>
      <term name="editor" form="short">a cura di</term>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>

  <!-- Autore nel testo: COGNOME in maiuscoletto; più autori separati da trattino breve (-) -->
  <macro name="author-short">
    <names variable="author">
      <name form="short" font-variant="small-caps" delimiter="-"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title" font-style="italic"/>
      </substitute>
    </names>
  </macro>

  <!-- Autore in bibliografia: Cognome, I. (come negli esempi: "Dumézil, G.") -->
  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter="-"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter="-"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <names variable="translator"/>
        <text variable="title" font-style="italic"/>
      </substitute>
    </names>
  </macro>

  <!-- Anno solo per l'ordinamento -->
  <macro name="issued-year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <!-- Anno visualizzato + lettera di disambiguazione (a, b, c) in corsivo -->
  <macro name="year-display">
    <group>
      <text macro="issued-year"/>
      <text variable="year-suffix" font-style="italic"/>
    </group>
  </macro>

  <macro name="title">
    <choose>
      <if type="article-journal article-magazine article-newspaper chapter paper-conference" match="any">
        <text variable="title"/>
      </if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>

  <!-- Edizione originale tra quadre (traduzioni) + eventuale nota tra quadre,
       es. [Idées romaines, Gallimard, Paris, 1969] oppure [tr. it. in Dumont 1966, pp. 401-427] -->
  <macro name="extras">
    <group delimiter=" ">
      <group prefix="[" suffix="]" delimiter=", ">
        <text variable="original-title" font-style="italic"/>
        <text variable="original-publisher"/>
        <text variable="original-publisher-place"/>
        <date variable="original-date">
          <date-part name="year"/>
        </date>
      </group>
      <text variable="note" prefix="[" suffix="]"/>
    </group>
  </macro>

  <!-- CITAZIONE NEL TESTO: (COGNOME 2006a: 154-155); Ivi: 200; Ibidem -->
  <citation disambiguate-add-year-suffix="true">
    <sort>
      <key macro="author-short"/>
      <key macro="issued-year"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <choose>
        <if position="ibid-with-locator">
          <group delimiter=": ">
            <text value="Ivi"/>
            <text variable="locator"/>
          </group>
        </if>
        <else-if position="ibid">
          <text value="Ibidem" font-style="italic"/>
        </else-if>
        <else>
          <group delimiter=" ">
            <text macro="author-short"/>
            <text macro="year-display"/>
          </group>
          <text variable="locator" prefix=": "/>
        </else>
      </choose>
    </layout>
  </citation>

  <!-- BIBLIOGRAFIA -->
  <bibliography hanging-indent="true">
    <sort>
      <key macro="author-bib"/>
      <key macro="issued-year"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=" ">
        <text macro="author-bib"/>
        <text macro="year-display"/>
        <choose>
          <!-- Articoli: titolo, «Rivista», numero (annata in numeri romani minuscoli), pp. -->
          <if type="article-journal article-magazine article-newspaper" match="any">
            <group delimiter=", ">
              <text macro="title"/>
              <text variable="container-title" prefix="«" suffix="»"/>
              <group delimiter=" ">
                <text variable="issue"/>
                <number variable="volume" form="roman" text-case="lowercase" prefix="(" suffix=")"/>
              </group>
              <group delimiter=" ">
                <label variable="page" form="short"/>
                <text variable="page"/>
              </group>
            </group>
          </if>
          <!-- Saggi in volume -->
          <else-if type="chapter paper-conference" match="any">
            <group delimiter=", ">
              <text macro="title"/>
              <group delimiter=" ">
                <text term="in"/>
                <text variable="container-title" font-style="italic"/>
              </group>
              <names variable="editor">
                <label form="short" suffix=" "/>
                <name initialize-with=". " delimiter="-"/>
              </names>
              <text macro="publisher"/>
              <group delimiter=" ">
                <label variable="page" form="short"/>
                <text variable="page"/>
              </group>
            </group>
          </else-if>
          <!-- Libri e altri tipi -->
          <else>
            <group delimiter=", ">
              <text macro="title"/>
              <text macro="publisher"/>
            </group>
          </else>
        </choose>
        <text macro="extras"/>
      </group>
    </layout>
  </bibliography>
</style>
